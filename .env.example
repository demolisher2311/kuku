# Copy this file to .env and fill in your key. .env is git-ignored; never commit it.

# Which model finds and judges the promos. Options: gemini | groq | openrouter | openai | anthropic | ollama
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
# Free key: https://aistudio.google.com/apikey (free tier: ~18 calls/min, 500 calls/day per model)
# Paid alternative used in earlier runs: LLM_PROVIDER=openai, LLM_MODEL=gpt-4.1-mini
LLM_API_KEY=
# For any OpenAI-compatible API (e.g. a company gateway), set provider=openai and:
# LLM_BASE_URL=https://your-gateway.example.com/v1

# Optional: a different model for the judge (falls back to the LLM_* model)
# JUDGE_PROVIDER=openai
# JUDGE_MODEL=gpt-4.1-mini
# JUDGE_API_KEY=

# Optional: judge style. pairwise (default) | strict | classic
# JUDGE_STYLE=pairwise
